# Environment (development | production)
ENVIRONMENT=production

# Security
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_environment

# Database: Default SQLite for local zero-config, PostgreSQL in production (e.g. Neon.tech)
# Neon.tech PostgreSQL Example: postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-weather-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./varuna_dev.db

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# Provenance Mode: synthetic_demo | historical_public | authorized_operational
DEFAULT_DATA_PROVENANCE=synthetic_demo

# xAI Grok Integration (Optional)
# XAI_API_KEY=xai-your-api-key-here
# XAI_MODEL=grok-beta

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
