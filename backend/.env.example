# ==============================================================================
# VARUNA Environment Configuration (.env.example)
# SIH 2026 Problem Statement: SIH26081
# Adaptive Forecast Intelligence Platform
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
ENVIRONMENT=development

# Application Secret Key (used for cryptographic signatures / session security)
# CRITICAL: Replace with a 64+ char random string in production. Never commit production keys.
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_38472910

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Air-Gapped Mode: If true, all external outbound network requests (including Grok/LLM) are strictly blocked
AIR_GAPPED_MODE=false

# ------------------------------------------------------------------------------
# Storage & Database Architecture
# ------------------------------------------------------------------------------
# Local Zero-Config Mode:
DATABASE_URL=sqlite:///./varuna_dev.db

# Scalable Demo / Production Mode (e.g., Neon.tech PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-weather-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Data Storage Architecture (local | s3)
STORAGE_PROVIDER=local
DATA_STORAGE_PATH=./data/storage
STORAGE_LOCAL_PATH=./data/storage
ML_MODEL_PATH=./data/storage/models

# Streaming Ingestion Bounded Chunk Size (Records per chunk to prevent OOM)
DATA_CHUNK_SIZE=10000

# Object Storage Credentials (Optional, only needed if STORAGE_PROVIDER=s3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=varuna-nwp-grids
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Data Providers & Operational Mode
# ------------------------------------------------------------------------------
# Default Data Provenance: PUBLIC_BENCHMARK | SYNTHETIC_STRESS_TEST | AUTHORIZED_OPERATIONAL_FEED
DEFAULT_DATA_PROVENANCE=SYNTHETIC_STRESS_TEST

# Enable External Real-Time Feeds (Requires institution clearance when true)
ENABLE_EXTERNAL_PROVIDERS=false

# ------------------------------------------------------------------------------
# India-first sources (see DATA_SOURCES.md)
# ------------------------------------------------------------------------------
# IMD API (api.imd.gov.in) — enable only after IMD grants access (usually your server IP is whitelisted).
IMD_API_ENABLED=false
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_API_KEY_HEADER=Authorization
# Region -> IMD station / district ids (JSON). Defaults exist for a few subdivisions; verify them with IMD.
# IMD_STATION_MAP={"IN_TELANGANA_DECCAN": {"station": "43128", "name": "Hyderabad"}}
# IMD daily rainfall day window: 9 = model hours 09:00 D .. 08:00 D+1 IST (≈ IMD 08:30 IST day)
IMD_RAIN_DAY_OFFSET_HOURS=9
# Folder where NCMRWF / IMD product files are delivered (SFTP drop, mounted share, bucket sync)
NCMRWF_DROP_DIR=

# Global public model data over India (Open-Meteo: GFS, ECMWF IFS, ECMWF AIFS, UK Met Office UM, DWD ICON + ERA5).
# No key needed for non-commercial use; blocked automatically when AIR_GAPPED_MODE=true.
LIVE_DATA_ENABLED=true
# OPEN_METEO_API_KEY=            # commercial plan only; then point the URLs below at customer-*.open-meteo.com
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
LIVE_HTTP_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------------------
# Explainable AI (XAI) / LLM Boundary Settings
# ------------------------------------------------------------------------------
# Grok is strictly OPTIONAL and NEVER influences numerical forecast blending.
# Numerical core works 100% offline with zero external API dependencies.
ENABLE_GROK=false
GROK_API_KEY=
GROK_MODEL=grok-beta

# Legacy Aliases
XAI_API_KEY=
XAI_MODEL=grok-beta

# Any OpenAI-compatible chat-completions base URL used by the optional briefing LLM.
#   xAI Grok : https://api.x.ai/v1
#   Groq     : https://api.groq.com/openai/v1   (keys starting with "gsk_" are Groq keys — detected automatically;
#              set GROQ_MODEL to a current Groq model, default llama-3.3-70b-versatile)
LLM_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_SECONDS=4.0

# Explicit CORS allow-list (JSON list). Leave ["*"] only for local development.
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# Meteorological Decision Guidance Standards (IMD Thresholds)
# ------------------------------------------------------------------------------
HEAVY_RAINFALL_THRESHOLD_MM=64.5
VERY_HEAVY_RAINFALL_THRESHOLD_MM=115.5
EXTREMELY_HEAVY_RAINFALL_THRESHOLD_MM=204.4
HIGH_TEMP_THRESHOLD_C=40.0
HIGH_WIND_THRESHOLD_KMH=50.0
HIGH_WIND_THRESHOLD_MS=14.0
