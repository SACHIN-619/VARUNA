# ==============================================================================
# VARUNA Environment Configuration (.env.example)
# SIH 2026 Problem Statement: SIH26081
# Adaptive Forecast Intelligence Platform
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
ENVIRONMENT=development

# Application Secret Key
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_38472910

# Logging Level
LOG_LEVEL=INFO

# Air-Gapped Mode
AIR_GAPPED_MODE=false

# Database Configuration (SQLite local default, or PostgreSQL/Neon)
DATABASE_URL=sqlite:///./varuna_dev.db
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-weather-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Ingestion & Storage Architecture
STORAGE_PROVIDER=local
DATA_STORAGE_PATH=./data/storage
STORAGE_LOCAL_PATH=./data/storage
ML_MODEL_PATH=./data/storage/models
DATA_CHUNK_SIZE=10000

# Providers & Operational Provenance
DEFAULT_DATA_PROVENANCE=SYNTHETIC_STRESS_TEST
ENABLE_EXTERNAL_PROVIDERS=false

# Optional LLM / Grok Integration (Numerical core works 100% offline)
ENABLE_GROK=false
GROK_API_KEY=
GROK_MODEL=grok-beta
