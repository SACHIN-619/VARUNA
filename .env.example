# Environment (development | production)
ENVIRONMENT=production

# Security
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_environment

# Database: Default SQLite for local zero-config, PostgreSQL in production
# Example PostgreSQL: postgresql://varuna_user:secure_password@localhost:5432/varuna_db
DATABASE_URL=sqlite:///./varuna_dev.db

# CORS Allowed Origins (Comma separated or json array)
CORS_ORIGINS=["*"]

# Provenance Mode: synthetic_demo | historical_public | authorized_operational
DEFAULT_DATA_PROVENANCE=synthetic_demo

# Future Cloud Object Storage (S3 / MinIO / Supabase)
# STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# STORAGE_BUCKET=varuna-nwp-grids
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Future Redis Cache
# REDIS_URL=redis://localhost:6379/0
