# Environment (development | production)
ENVIRONMENT=production

# Security
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_environment

# Database: Default SQLite for local zero-config, PostgreSQL in production (e.g. Neon.tech)
# Neon.tech PostgreSQL Example: postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-weather-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./varuna_dev.db

# CORS Allowed Origins (Comma separated or json array)
CORS_ORIGINS=["*"]

# Provenance Mode: synthetic_demo | historical_public | authorized_operational
DEFAULT_DATA_PROVENANCE=synthetic_demo

# xAI Grok Integration (Optional: Used for meteorological briefing synthesis, NOT for deciding model weights)
# XAI_API_KEY=xai-your-api-key-here
# XAI_MODEL=grok-beta

# Storage Provider (local | s3 | supabase)
# Default 'local' creates and reads from ./data/storage/ (no cloud credentials required)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage

# Future S3 / MinIO / Supabase Object Storage (Leave blank if STORAGE_PROVIDER=local)
# STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# STORAGE_BUCKET=varuna-nwp-grids
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
